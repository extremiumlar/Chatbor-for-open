# https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Telethon seans fayli nomi (my_account.session shu nom bilan yaratiladi/o'qiladi)
SESSION_NAME=my_account

# Baza (MVP-1: SQLite, kelajakda PostgreSQL'ga o'zgartiriladi)
DATABASE_URL=sqlite+aiosqlite:///./data_relay.db

# TZ 2.2 (Q48) — mijoz kupon yubormasa necha soniyadan keyin seans to'xtaydi
CUSTOMER_COUPON_TIMEOUT_SECONDS=300

# TZ 4.1 (Q46) — haqiqiy O'zbekiston operator kodlari (vergul bilan)
UZ_OPERATOR_CODES=90,91,93,94,95,97,98,99,33,88,20

# MVP-1: mock tekshiruv bot pool'ini boshlang'ich to'ldirish uchun slot nomlari
BOT_POOL_USERNAMES=mock_bot_1,mock_bot_2,mock_bot_3,mock_bot_4,mock_bot_5

# MVP-2: Adminbot tokeni (@BotFather'dan)
ADMINBOT_TOKEN=

# MVP-2 (TZ 12.2) — boshlang'ich admin Telegram ID-lari (vergul bilan).
# BO'SH QOLDIRMANG — aks holda Adminbotga hech kim buyruq bera olmaydi.
# O'z Telegram ID-ingizni bilish uchun @userinfobot ga yozing.
ADMIN_TG_IDS=

# MVP-3 (TZ 12-bo'lim) — tekshiruv bot javob bermasa necha marta va
# qancha kutib (backoff: har urinishda ikki baravar) qayta urinish
BOT_RESPONSE_MAX_RETRIES=3
BOT_RESPONSE_BACKOFF_SECONDS=1.0

# MVP-3 (TZ 5.2) — "Xavfsiz" deb belgilangan shubhali case necha
# soniyada bir tekshirilib avtomatik dispatch qilinishi
SUSPICIOUS_RESUME_POLL_SECONDS=3.0

# MVP-4 (TZ 13-bo'lim, Q60) — kunlik avtomatik SQLite backup
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION=14

# MVP-4 (TZ 12.1) — strukturali log fayllar papkasi
LOG_DIR=./logs

# MVP-5 — real tekshiruv botlariga ulanish. STANDART: false (mock bot bilan
# davom etadi). True qilishdan oldin /botpatterns orqali barcha 4 ta
# bot-tanish shablonini kiriting (TZ 9.4, Q16) — aks holda tizim STOP bo'ladi.
# ⚠️ real_bot_adapter hali haqiqiy botga qarshi sinalmagan — ehtiyot bo'ling.
USE_REAL_VERIFICATION_BOTS=false

# =========================================================================
# TZ v2 (Qo'lda Admin Oqimi) — teleton_service.manual_relay uchun.
# Quyidagilar faqat BOSHLANG'ICH qiymatlar: jonli qiymatlar adminbot orqali
# sozlanadi (GROUP_CHAT_ID, CHECKER_ACCOUNT, shablonlar — faqat adminbotda).
# =========================================================================

# Admin Telethon sessiyalari papkasi (scripts/add_admin_session.py yaratadi).
# TZ v2 13.4 — bu papka backupga KIRMAYDI, huquqlari qattiq cheklanadi.
SESSIONS_DIR=./sessions

# TZ v2 6.1 — rasm tashlangandan keyin tekshiruvgacha kutish (daqiqa).
CHECK_DELAY_MINUTES=90

# TZ v2 6.1 a2 — rasmsizlik eslatmasi: birinchisi nomer kelganidan necha
# daqiqada, jami nechta.
NO_SCREENSHOT_FIRST_MINUTES=30
NO_SCREENSHOT_REMINDERS=3

# TZ v2 5.1 — albom bo'lmagan rasmlarni bitta partiya deb hisoblash oynasi.
IMAGE_BATCH_WINDOW_SECONDS=15

# MVP-6 — Web panel (FastAPI + Telegram Login Widget, TZ 13-bo'lim).
# Adminbot bilan BIR XIL bot username'i (ADMINBOT_TOKEN'ga tegishli bot).
# ⚠️ Widget ishlashi uchun @BotFather'da shu botga /setdomain orqali
# panel xizmat qiladigan REAL HTTPS domenni sozlash SHART.
ADMINBOT_USERNAME=
PANEL_HOST=0.0.0.0
PANEL_PORT=8000
# Sozlanmasa har ishga tushirishda tasodifiy yaratiladi (seanslar restart'da
# bekor bo'ladi) — production'da o'zingiz uzun tasodifiy qiymat qo'ying.
PANEL_SESSION_SECRET=
